import numpy as np
import soundfile as sf
import sounddevice as sd
import matplotlib.pyplot as plt
from scipy.signal import cheby2, freqz

# === 1. Generar coeficientes Chebyshev II ===
def generar_coeficientes_pasabajas(fc, fs, orden=4, atenuacion=40):
    b, a = cheby2(N=orden, rs=atenuacion, Wn=fc/(fs/2), btype='low')
    return b, a

# === 2. Aplicar filtro con ecuación de diferencias ===
def aplicar_filtro_iir(data, b, a):
    N = len(b)
    x_hist = np.zeros(N)
    y_hist = np.zeros(N)
    salida = np.zeros_like(data)

    for n in range(len(data)):
        x_hist[1:] = x_hist[:-1]
        x_hist[0] = data[n]

        y = 0.0
        for i in range(N):
            y += b[i] * x_hist[i]
        for i in range(1, N):
            y -= a[i] * y_hist[i-1]

        y_hist[1:] = y_hist[:-1]
        y_hist[0] = y

        salida[n] = y

    return salida

# === 3. Graficar FFT ===
def graficar_fft(signal, fs, titulo):
    N = len(signal)
    freq = np.fft.rfftfreq(N, 1/fs)
    espectro = np.abs(np.fft.rfft(signal))
    plt.plot(freq, espectro)
    plt.title(titulo)
    plt.xlabel("Frecuencia (Hz)")
    plt.ylabel("Magnitud")
    plt.grid(True)

# === 4. Graficar respuesta en frecuencia del filtro ===
def graficar_respuesta_filtro(b, a, fs):
    w, h = freqz(b, a, worN=8000)
    freqs = w * fs / (2 * np.pi)
    plt.plot(freqs, 20 * np.log10(abs(h)))
    plt.title("Respuesta en Frecuencia del Filtro (Bode)")
    plt.xlabel("Frecuencia (Hz)")
    plt.ylabel("Magnitud (dB)")
    plt.grid(True)


# === Graficar FFT con normalización, zoom y marca de frecuencia de corte ===
def graficar_fft(signal, fs, titulo, fc=None):
    N = len(signal)
    freq = np.fft.rfftfreq(N, 1/fs)
    espectro = np.abs(np.fft.rfft(signal))
    espectro /= np.max(espectro)  # Normalizar

    plt.plot(freq, espectro)
    plt.title(titulo)
    plt.xlabel("Frecuencia (Hz)")
    plt.ylabel("Magnitud Normalizada")
    plt.xlim(0, 10000)  # Zoom hasta 10 kHz
    plt.ylim(0, 1.05)   # Máximo 1.0 por normalización
    if fc:
        plt.axvline(fc, color='red', linestyle='--', label=f'fc = {fc} Hz')
        plt.legend()
    plt.grid(True)

# === Graficar respuesta del filtro con línea de corte ===
def graficar_respuesta_filtro(b, a, fs, fc=None):
    from scipy.signal import freqz
    w, h = freqz(b, a, worN=8000)
    freqs = w * fs / (2 * np.pi)
    plt.plot(freqs, 20 * np.log10(abs(h)))
    plt.title("Respuesta en Frecuencia del Filtro (Bode)")
    plt.xlabel("Frecuencia (Hz)")
    plt.ylabel("Magnitud (dB)")
    plt.xlim(0, 10000)
    plt.ylim(-100, 5)
    if fc:
        plt.axvline(fc, color='red', linestyle='--', label=f'fc = {fc} Hz')
        plt.legend()
    plt.grid(True)

# === MAIN ===
# Cargar archivo de audio
archivo = "C:\\Users\\yarit\\Music\\audio.wav"  # Cambia esto por el nombre de tu archivo
data, fs = sf.read(archivo)
if data.ndim > 1:
    data = data[:, 0]  # Convertir a mono

# Parámetros del filtro
fc = float(input("Ingrese la frecuencia de corte (Hz): "))
orden = 2
atenuacion = 40

# Generar coeficientes
b, a = generar_coeficientes_pasabajas(fc, fs, orden, atenuacion)
print("Coeficientes b:", b)
print("Coeficientes a:", a)

# Aplicar filtro
filtrado = aplicar_filtro_iir(data, b, a)

# Graficar espectros
plt.figure(figsize=(14, 6))

plt.subplot(1, 3, 1)
graficar_fft(data, fs, "FFT - Señal Original", fc)

plt.subplot(1, 3, 2)
graficar_fft(filtrado, fs, f"FFT - Filtrada (fc={fc} Hz)", fc)

plt.subplot(1, 3, 3)
graficar_respuesta_filtro(b, a, fs, fc)

plt.tight_layout()
plt.show()

# Reproducir señal filtrada
print("Reproduciendo señal filtrada...")
sd.play(filtrado, fs)
sd.wait()
